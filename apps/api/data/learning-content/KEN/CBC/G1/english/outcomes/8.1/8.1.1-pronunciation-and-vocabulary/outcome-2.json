nds."},{"phase":"exit-check","progressionLevel":6,"mode":"picture-choice","prompt":"Which sequence matches /k/, /d/, /w/?","choices":["kite, drum, water","drum, water, kite","water, kite, drum"],"answer":"kite, drum, water","feedback":"Excellent clear-sound work!","retryHint":"Find /k/, then /d/, then /w/."}]}}
