{
  "name": "@kitabu/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test src/googleAuth.test.ts src/payments.test.ts src/mufasaTelemetry.test.ts src/aiFeatures.test.ts src/generatedBooks.test.ts src/quizBank.test.ts src/legalPages.test.ts src/assignmentTargeting.test.ts",
    "test:integration": "tsx --test src/auth.integration.test.ts",
    "check:mpesa": "node scripts/check-mpesa.mjs",
    "check:readiness": "node scripts/verify-production-readiness.mjs",
    "check:mufasa-telemetry-contract": "node scripts/validate-mufasa-telemetry-contract.mjs",
    "download:source-files": "node scripts/curriculum/download-missing-source-files.mjs",
    "export:source-markdown": "node scripts/curriculum/export-source-markdown.mjs",
    "audit:ethiopia-coverage": "node scripts/curriculum/audit-ethiopia-coverage.mjs",
    "validate:quiz-bank": "node scripts/quiz-bank/validate-quiz-bank.mjs",
    "report:quiz-bank": "node scripts/quiz-bank/report-quiz-bank-coverage.mjs",
    "import:quiz-bank": "node scripts/quiz-bank/import-quiz-bank.mjs",
    "validate:book-package": "node scripts/curriculum/validate-book-package.mjs",
    "verify:source-markdown": "node scripts/curriculum/verify-source-markdown.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/apply-migrations.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.2",
    "chess.js": "^1.4.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "ws": "^8.21.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
