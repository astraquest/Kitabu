{
	auto_https off
}

http://kitabu.ai, http://www.kitabu.ai {
	root * /srv/www
	encode gzip zstd
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		?Cache-Control "public, max-age=300, stale-while-revalidate=86400"
	}
	@immutableAssets path /assets/* /styles-*.css /site-*.js
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"
	@resetPasswordPath {
		path_regexp (?i)^/reset-password/?$
	}
	redir @resetPasswordPath https://app.kitabu.ai/reset-password?{query} 308
	@verifyEmailPath {
		path_regexp (?i)^/verify-email/?$
	}
	redir @verifyEmailPath https://app.kitabu.ai/verify-email?{query} 308
	@privacyPath {
		path_regexp (?i)^/privacy/?$
	}
	redir @privacyPath https://app.kitabu.ai/privacy 308
	@policyPath {
		path_regexp (?i)^/policy/?$
	}
	redir @policyPath https://app.kitabu.ai/policy 308
	@termsPath {
		path_regexp (?i)^/terms/?$
	}
	redir @termsPath https://app.kitabu.ai/terms 308
	@deletionPath {
		path_regexp (?i)^/deletion/?$
	}
	redir @deletionPath https://app.kitabu.ai/deletion 308
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

http://app.kitabu.ai {
	reverse_proxy 127.0.0.1:4000
}

http://admin.kitabu.ai {
	root * /srv/admin
	encode gzip zstd
	@static_assets path /app.js /styles.css /assets/*
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://app.kitabu.ai; frame-src 'self' https://app.kitabu.ai; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Robots-Tag "noindex, nofollow"
		?Cache-Control "no-store"
	}
	header @static_assets Cache-Control "public, max-age=300"
	file_server
}
