{
  "name": "kitabu-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "packages/runtime-contracts"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api",
    "build:runtime": "npm run build -w packages/runtime-contracts",
    "check": "npm run build:runtime && npm run typecheck -w apps/api && node scripts/check-admin-icons.mjs",
    "typecheck:runtime": "npm run typecheck -w packages/runtime-contracts",
    "test:runtime": "npm run test -w packages/runtime-contracts --if-present",
    "validate:runtime": "npm run validate -w packages/runtime-contracts --if-present",
    "test:api": "npm test -w apps/api",
    "test:native": "npm --prefix native-app test -- --runInBand",
    "lint:native": "npm --prefix native-app run lint -- --max-warnings=0",
    "typecheck:native": "npm --prefix native-app run typecheck",
    "readiness:production": "npm run check:readiness -w apps/api",
    "release:check": "npm run check && npm run build && npm run test:api && npm run check:mufasa-telemetry-contract -w apps/api && npm run typecheck:native && npm run lint:native && npm run test:native && npm run readiness:production",
    "deploy:build": "docker compose build api worker"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.7.0"
  }
}
