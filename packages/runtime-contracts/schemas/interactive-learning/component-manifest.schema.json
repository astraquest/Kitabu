{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitabu.ai/schemas/interactive-learning/component-manifest/1.0.1",
  "title": "Kitabu Installed Interactive Component Manifest",
  "description": "A component version compiled into this runtime. This is not the roadmap catalogue and cannot describe unavailable components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "displayName",
    "kind",
    "maturity",
    "owner",
    "rendererBindings",
    "capabilityTiers",
    "propsSchemaBindingId",
    "stateSchemaVersion",
    "supportedTutorActions",
    "emittedEvents",
    "evidenceTypes",
    "privacyClasses"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "componentVersion", "specVersion"],
      "properties": {
        "componentId": { "$ref": "#/$defs/localIdentifier" },
        "componentVersion": { "$ref": "#/$defs/exactSemVer" },
        "specVersion": { "const": "1.0.1" }
      }
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "kind": {
      "enum": ["primitive", "pattern", "engine", "composition"]
    },
    "maturity": {
      "description": "Only shipped implementations may enter the installed registry.",
      "enum": ["build-now", "adapter"]
    },
    "owner": { "$ref": "#/$defs/localIdentifier" },
    "rendererBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["renderer", "bindingId"],
        "properties": {
          "renderer": { "enum": ["native", "dom", "webgl", "adapter"] },
          "bindingId": { "$ref": "#/$defs/localIdentifier" }
        }
      }
    },
    "capabilityTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["lite", "interactive", "immersive"] }
    },
    "propsSchemaBindingId": { "$ref": "#/$defs/localIdentifier" },
    "stateSchemaVersion": { "$ref": "#/$defs/exactSemVer" },
    "supportedTutorActions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tutorAction" }
    },
    "emittedEvents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/componentEvent" }
    },
    "evidenceTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "answer",
          "construction",
          "process",
          "explanation",
          "observation",
          "creation",
          "collaboration"
        ]
      }
    },
    "privacyClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ordinary-learning-event",
          "learner-authored-content",
          "sensitive-inference",
          "raw-audio",
          "raw-image-video",
          "precise-location",
          "biometric-or-pose"
        ]
      }
    },
    "fallbackComponentId": { "$ref": "#/$defs/localIdentifier" }
  },
  "$defs": {
    "exactSemVer": {
      "type": "string",
      "description": "An exact release version; ranges, tags and prereleases are not runtime identities.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "localIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "A key resolved from code bundled with the app. URLs, package ranges and filesystem traversal are forbidden.",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "tutorAction": {
      "enum": [
        "highlight",
        "annotate",
        "freeze",
        "unfreeze",
        "rewind",
        "replay",
        "setParameter",
        "reveal",
        "hide",
        "switchRepresentation",
        "spawnCounterexample",
        "insertMicroTask",
        "modelPartialAction",
        "requestPrediction",
        "requestExplanation",
        "fadeScaffold",
        "focusCamera"
      ]
    },
    "componentEvent": {
      "enum": [
        "READY",
        "INTERACTION",
        "EVIDENCE",
        "ANSWER_CHANGED",
        "HINT_REQUESTED",
        "SUBMITTED",
        "COMPLETED",
        "STATE_SNAPSHOT",
        "CAPABILITY_WARNING",
        "TUTOR_ACTION_RESULT",
        "ERROR"
      ]
    }
  }
}
