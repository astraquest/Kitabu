{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitabu.ai/schemas/interactive-learning/snapshot/1.0.1",
  "title": "Kitabu Interactive Learning Component Snapshot",
  "description": "A JSON-safe component state checkpoint bound to one attempt and immutable content/component revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotSchemaVersion",
    "attemptId",
    "bundleId",
    "bundleRevision",
    "sceneId",
    "sceneRevision",
    "componentId",
    "componentVersion",
    "stateVersion",
    "sequence",
    "savedAt",
    "state"
  ],
  "properties": {
    "snapshotSchemaVersion": { "const": "1.0.1" },
    "attemptId": { "$ref": "#/$defs/id" },
    "bundleId": { "$ref": "#/$defs/id" },
    "bundleRevision": { "$ref": "#/$defs/revision" },
    "sceneId": { "$ref": "#/$defs/id" },
    "sceneRevision": { "$ref": "#/$defs/revision" },
    "componentId": { "$ref": "#/$defs/id" },
    "componentVersion": { "$ref": "#/$defs/semver" },
    "stateVersion": { "$ref": "#/$defs/semver" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": { "$ref": "#/$defs/jsonValue" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
